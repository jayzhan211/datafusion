# This file runs with the `OutputRequirements` remove step before its add step
# (see `rule_order.rs`), so the marker is still in the plan after the last rule.
# The planner must drop it: the marker can't execute.

statement ok
CREATE TABLE t (id INT, v INT) AS VALUES (2, 20), (1, 10), (3, 30);

query II
SELECT id, v FROM t ORDER BY id;
----
1 10
2 20
3 30

query TT
EXPLAIN SELECT id FROM t ORDER BY id LIMIT 1;
----
logical_plan
01)Sort: t.id ASC NULLS LAST, fetch=1
02)--TableScan: t projection=[id]
physical_plan
01)SortExec: TopK(fetch=1), expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

statement ok
DROP TABLE t;
