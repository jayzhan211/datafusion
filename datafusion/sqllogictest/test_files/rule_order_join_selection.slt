# This file runs `JoinSelection` after `EnsureRequirements` (see `rule_order.rs`).
# Enforcement must settle the mode of a join still in `Auto` mode, and
# `JoinSelection` must not then pick a mode or swap inputs in a way that breaks
# the requirements enforcement already met.

statement ok
CREATE TABLE small (a INT, b INT) AS VALUES (1, 10), (2, 20);

statement ok
CREATE TABLE big (a INT, c INT) AS VALUES (1, 100), (2, 200), (2, 201), (3, 300);

query III
SELECT small.a, b, c FROM small JOIN big ON small.a = big.a ORDER BY c;
----
1 10 100
2 20 200
2 20 201

query III
SELECT big.a, b, c FROM big LEFT JOIN small ON small.a = big.a ORDER BY c;
----
1 10 100
2 20 200
2 20 201
3 NULL 300

query II
SELECT a, c FROM big WHERE a NOT IN (SELECT a FROM small);
----
3 300

query II
SELECT small.a, big.a FROM small CROSS JOIN big ORDER BY small.a, big.c LIMIT 2;
----
1 1
1 2

statement ok
DROP TABLE small;

statement ok
DROP TABLE big;
