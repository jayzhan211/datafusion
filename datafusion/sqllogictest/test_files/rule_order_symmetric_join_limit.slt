# This file runs `LimitPushdown` before `JoinSelection` (see `rule_order.rs`). The hash
# join absorbs the limit as a fetch, which `SymmetricHashJoinExec` can't carry.

statement ok
COPY (SELECT column1 AS a, column2 AS b FROM (VALUES (1,10),(2,20),(3,30),(4,40))) TO 'test_files/scratch/rule_order_symmetric_join_limit/l.csv' STORED AS CSV OPTIONS ('format.has_header' 'true');

statement ok
COPY (SELECT column1 AS a, column2 AS c FROM (VALUES (1,100),(2,200),(3,300),(4,400))) TO 'test_files/scratch/rule_order_symmetric_join_limit/r.csv' STORED AS CSV OPTIONS ('format.has_header' 'true');

statement ok
CREATE UNBOUNDED EXTERNAL TABLE ul (a INT, b INT) STORED AS CSV LOCATION 'test_files/scratch/rule_order_symmetric_join_limit/l.csv' OPTIONS ('format.has_header' 'true');

statement ok
CREATE UNBOUNDED EXTERNAL TABLE ur (a INT, c INT) STORED AS CSV LOCATION 'test_files/scratch/rule_order_symmetric_join_limit/r.csv' OPTIONS ('format.has_header' 'true');

query I rowsort
SELECT 1 FROM ul JOIN ur ON ul.a=ur.a LIMIT 1;
----
1

statement ok
DROP TABLE ul;

statement ok
DROP TABLE ur;
