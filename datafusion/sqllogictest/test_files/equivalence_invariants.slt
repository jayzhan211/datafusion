statement ok
CREATE EXTERNAL TABLE w (a INT, b INT) STORED AS CSV
WITH ORDER (a) WITH ORDER (b)
LOCATION 'test_files/scratch/equivalence_invariants/w/'
OPTIONS ('format.has_header' 'true');

# A merge on a keeps only the ordering on a, so the outer
# ORDER BY b needs its sort (main dropped it and returned b unsorted).
query TT
EXPLAIN SELECT * FROM (SELECT a, b FROM w ORDER BY a LIMIT 10) ORDER BY b;
