# A RIGHT join keeps the null-extended left side's constant c.
# Plan only: main drops the NULLS FIRST sort on l.c (kept as on main).
statement ok
set datafusion.execution.target_partitions = 1;

statement ok
CREATE TABLE jl (k INT, c INT) AS VALUES (1, 5), (3, 5), (2, 6);

statement ok
CREATE TABLE jr (k INT, x INT) AS VALUES (1, 1), (2, 1);

query TT
EXPLAIN SELECT jr.x, l.c, jr.k FROM (SELECT * FROM jl WHERE c = 5) l RIGHT JOIN jr ON l.k = jr.k ORDER BY jr.x, l.c NULLS FIRST;
