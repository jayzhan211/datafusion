01)HashJoinExec: mode=CollectLeft, join_type=Right, on=[(k@0, k@0)], projection=[x@3, c@1, k@2]
02)--FilterExec: c@1 = 5
03)----DataSourceExec: partitions=1, partition_sizes=[1]
04)--SortExec: expr=[x@1 ASC NULLS LAST], preserve_partitioning=[false]
05)----DataSourceExec: partitions=1, partition_sizes=[1]

# The inner side's constants survive a LEFT join on the preserved side.
query TT
EXPLAIN SELECT l.c, jr.x FROM (SELECT * FROM jl WHERE c = 5) l LEFT JOIN jr ON l.k = jr.k ORDER BY l.c, jr.x;
