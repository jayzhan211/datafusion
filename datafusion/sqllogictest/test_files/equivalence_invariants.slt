# Union where each side orders a column the other leaves unordered: x is a
# strict image of a on the left side only, y on the right side only. Both
# sides are sorted by a, so the union is too.
query TT
EXPLAIN SELECT a, CAST(a AS BIGINT) x, CAST(d AS BIGINT) y FROM t
UNION ALL
SELECT a, CAST(d AS BIGINT) x, CAST(a AS BIGINT) y FROM t
ORDER BY a;
----
physical_plan
01)SortPreservingMergeExec: [a@0 ASC NULLS LAST]
02)--UnionExec
03)----ProjectionExec: expr=[a@0 as a, CAST(a@0 AS Int64) as x, CAST(d@1 AS Int64) as y]
04)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
05)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, d], output_ordering=[a@0 ASC NULLS LAST], file_type=csv, has_header=true
06)----ProjectionExec: expr=[a@0 as a, CAST(d@1 AS Int64) as x, CAST(a@0 AS Int64) as y]
07)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
08)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, d], output_ordering=[a@0 ASC NULLS LAST], file_type=csv, has_header=true

# Cross join keeps the left side's constants and orderings.
statement ok
CREATE TABLE small(x INT) AS VALUES (1), (2);

query TT
EXPLAIN SELECT l.b, l.c, s.x FROM (SELECT b, c FROM t WHERE b = 1) l CROSS JOIN small s ORDER BY l.b, l.c;
----
physical_plan
01)SortExec: expr=[c@1 ASC NULLS LAST], preserve_partitioning=[false]
02)--CrossJoinExec
03)----CoalescePartitionsExec
04)------FilterExec: b@0 = 1
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[b, c], output_ordering=[c@1 ASC NULLS LAST], file_type=csv, has_header=true
07)----DataSourceExec: partitions=1, partition_sizes=[1]

# Inner join: equi-join keys become equal, so ordering by the right key is
# ordering by the left key.
query TT
EXPLAIN SELECT l.a, l.b, r.a FROM t l JOIN t r ON l.a = r.a ORDER BY r.a;
----
physical_plan
01)SortPreservingMergeExec: [a@2 ASC NULLS LAST]
02)--HashJoinExec: mode=Partitioned, join_type=Inner, on=[(a@0, a@0)]
03)----RepartitionExec: partitioning=Hash([a@0], 4), input_partitions=1, maintains_sort_order=true
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b], output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], file_type=csv, has_header=true
05)----RepartitionExec: partitioning=Hash([a@0], 4), input_partitions=1, maintains_sort_order=true
06)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a], output_ordering=[a@0 ASC NULLS LAST], file_type=csv, has_header=true

# Primary key: an ordering that starts with a key satisfies any extension.
statement ok
CREATE EXTERNAL TABLE t_pk (
  a0 INTEGER,
  a INTEGER,
  b INTEGER,
  c INTEGER NOT NULL,
  d INTEGER,
  PRIMARY KEY (c)
)
STORED AS CSV
WITH ORDER (c ASC)
LOCATION '../core/tests/data/window_2.csv'
OPTIONS ('format.has_header' 'true');

query TT
EXPLAIN SELECT c, d FROM t_pk ORDER BY c, d;
----
physical_plan DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[c, d], output_ordering=[c@0 ASC NULLS LAST], constraints=[PrimaryKey([3])], file_type=csv, has_header=true

# The key shortcut sees the requirement after its constants are removed.
query TT
EXPLAIN SELECT a, c, d FROM t_pk WHERE a = 0 ORDER BY a, c, d;
----
physical_plan
01)SortPreservingMergeExec: [a@0 ASC NULLS LAST, c@1 ASC NULLS LAST]
02)--FilterExec: a@0 = 0
03)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, c, d], output_ordering=[c@1 ASC NULLS LAST], constraints=[PrimaryKey([3])], file_type=csv, has_header=true

# A nullable UNIQUE column in the middle of an ordering counts as a key
# (UNKNOWN: current.md U5, kept as on main).
statement ok
CREATE EXTERNAL TABLE t_unique (
  a0 INTEGER,
  a INTEGER,
  b INTEGER,
  c INTEGER,
  d INTEGER,
  UNIQUE (c)
)
STORED AS CSV
WITH ORDER (a ASC, c ASC, b ASC)
LOCATION '../core/tests/data/window_2.csv'
OPTIONS ('format.has_header' 'true');

query TT
EXPLAIN SELECT a, c, b, d FROM t_unique ORDER BY a, c, b, d;
----
physical_plan
01)ProjectionExec: expr=[a@0 as a, c@2 as c, b@1 as b, d@3 as d]
02)--SortExec: expr=[a@0 ASC NULLS LAST, c@2 ASC NULLS LAST, b@1 ASC NULLS LAST, d@3 ASC NULLS LAST], preserve_partitioning=[false]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b, c, d], output_ordering=[a@0 ASC NULLS LAST, c@2 ASC NULLS LAST, b@1 ASC NULLS LAST], constraints=[Unique([3])], file_type=csv, has_header=true

# The same column first in the ordering is not enough.
query TT
EXPLAIN SELECT c, b, d FROM t_unique ORDER BY c, b, d;
----
physical_plan
01)ProjectionExec: expr=[c@1 as c, b@0 as b, d@2 as d]
02)--SortExec: expr=[c@1 ASC NULLS LAST, b@0 ASC NULLS LAST, d@2 ASC NULLS LAST], preserve_partitioning=[false]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[b, c, d], constraints=[Unique([3])], file_type=csv, has_header=true

# Projection through a non-strict image (date_trunc-like: a / 2) keeps an
# ordering that ends at the image.
query TT
EXPLAIN SELECT a / 2 AS h, b FROM t ORDER BY h;
----
physical_plan
01)SortPreservingMergeExec: [h@0 ASC NULLS LAST]
02)--SortExec: expr=[h@0 ASC NULLS LAST], preserve_partitioning=[true]
03)----ProjectionExec: expr=[CAST(a@0 AS Int64) / 2 as h, b@1 as b]
04)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
05)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b], output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], file_type=csv, has_header=true

query TT
EXPLAIN SELECT a / 2 AS h, b FROM t ORDER BY h, b;
----
physical_plan
01)SortPreservingMergeExec: [h@0 ASC NULLS LAST, b@1 ASC NULLS LAST]
02)--SortExec: expr=[h@0 ASC NULLS LAST, b@1 ASC NULLS LAST], preserve_partitioning=[true]
03)----ProjectionExec: expr=[CAST(a@0 AS Int64) / 2 as h, b@1 as b]
04)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
05)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b], output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], file_type=csv, has_header=true

# a + 0 is ordered as a is but not strictly (Plus over unbounded ranges is
# not order preserving), so the sort stays.
query TT
EXPLAIN SELECT a + 0 AS x, b FROM t ORDER BY x, b;
----
physical_plan
01)SortPreservingMergeExec: [x@0 ASC NULLS LAST, b@1 ASC NULLS LAST]
02)--SortExec: expr=[x@0 ASC NULLS LAST, b@1 ASC NULLS LAST], preserve_partitioning=[true]
03)----ProjectionExec: expr=[CAST(a@0 AS Int64) + 0 as x, b@1 as b]
04)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
05)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b], output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], file_type=csv, has_header=true

# Duplicate aliases of one constant source: both are constant.
query TT
EXPLAIN SELECT b AS x, b AS y, c FROM t WHERE b = 1 ORDER BY y, x, c;
----
physical_plan
01)SortPreservingMergeExec: [y@1 ASC NULLS LAST, x@0 ASC NULLS LAST, c@2 ASC NULLS LAST]
02)--ProjectionExec: expr=[b@0 as x, b@0 as y, c@1 as c]
03)----FilterExec: b@0 = 1
04)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
05)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[b, c], output_ordering=[c@1 ASC NULLS LAST], file_type=csv, has_header=true

# Merges: SortPreservingMerge over one partition keeps the input's other
# ordering (and per-partition constants).
statement ok
set datafusion.execution.target_partitions = 1;

query TT
EXPLAIN SELECT * FROM (SELECT a, b, c FROM t ORDER BY a, b LIMIT 10) ORDER BY c;
----
