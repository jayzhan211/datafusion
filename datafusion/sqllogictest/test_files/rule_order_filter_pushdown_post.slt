# This file runs the post-optimization `FilterPushdown` before `JoinSelection`
# (see `rule_order.rs`). `JoinSelection` leaves a join that carries a dynamic
# filter unchanged, so the join's mode is still undecided when it reaches
# enforcement.

statement ok
CREATE TABLE l (a INT, b INT) AS VALUES (1, 10), (2, 20);

statement ok
CREATE TABLE r (a INT, c INT) AS VALUES (1, 100), (2, 200), (2, 201), (3, 300);

query III
SELECT l.a, b, c FROM l JOIN r ON l.a = r.a ORDER BY c;
----
1 10 100
2 20 200
2 20 201

query III
SELECT r.a, b, c FROM r LEFT JOIN l ON l.a = r.a ORDER BY c;
----
1 10 100
2 20 200
2 20 201
3 NULL 300

statement ok
DROP TABLE l;

statement ok
DROP TABLE r;
