# This file runs the first `ProjectionPushdown` before `EnsureRequirements` (see
# `rule_order.rs`). Enforcement then pushes a sort through a mark join that has an
# embedded projection, which can name the mark column.

statement ok
CREATE TABLE co(id INT, k INT) AS VALUES (1,1),(2,1),(NULL,1),(2,2),(NULL,3),(5,NULL),(9,9);

statement ok
CREATE TABLE ci(id INT, k INT) AS VALUES (1,1),(NULL,2),(7,1),(3,NULL);

query IIB
SELECT co.id, co.k, (co.k + 0) IN (SELECT ci.k FROM ci WHERE ci.k = co.k + 0) AS m FROM co ORDER BY k, id;
----
1 1 true
2 1 true
NULL 1 true
2 2 true
NULL 3 false
9 9 false
5 NULL false

statement ok
DROP TABLE co;

statement ok
DROP TABLE ci;
