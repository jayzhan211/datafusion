# This file runs `ProjectionPushdown` before `JoinSelection` (see `rule_order.rs`).
# `ProjectionPushdown` puts a projection in the hash join, then `JoinSelection`
# turns that join into a `SymmetricHashJoinExec`, which can't carry a projection.

statement ok
COPY (SELECT column1 AS a, column2 AS b FROM (VALUES (1, 10), (2, 20)))
TO 'test_files/scratch/rule_order_symmetric_join/l.csv'
STORED AS CSV OPTIONS ('format.has_header' 'true');

statement ok
COPY (SELECT column1 AS a, column2 AS c FROM (VALUES (1, 100), (2, 200), (3, 300)))
TO 'test_files/scratch/rule_order_symmetric_join/r.csv'
STORED AS CSV OPTIONS ('format.has_header' 'true');

statement ok
CREATE UNBOUNDED EXTERNAL TABLE l (a INT, b INT)
STORED AS CSV LOCATION 'test_files/scratch/rule_order_symmetric_join/l.csv'
OPTIONS ('format.has_header' 'true');

statement ok
CREATE UNBOUNDED EXTERNAL TABLE r (a INT, c INT)
STORED AS CSV LOCATION 'test_files/scratch/rule_order_symmetric_join/r.csv'
OPTIONS ('format.has_header' 'true');

query III rowsort
SELECT l.a, b, c FROM l FULL JOIN r ON l.a = r.a;
----
1 10 100
2 20 200
NULL NULL 300

statement ok
DROP TABLE l;

statement ok
DROP TABLE r;
