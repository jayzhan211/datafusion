# This file runs `JoinSelection` after `FilterPushdown`, both after `EnsureRequirements`
# (see `rule_order.rs`). A swap breaks the null-aware join's `CollectLeft`, and repairing
# that can't add parallelism: the subquery's limit relies on an order enforcement already
# removed the sort for. The 1000 smallest s with y = 1 are 1, 4, ... 2998.

statement ok
COPY (SELECT CASE WHEN value<0 THEN NULL ELSE value END AS s, value%3 AS y FROM generate_series(1,8000)) TO 'test_files/scratch/rule_order_reenforce/t.parquet' STORED AS PARQUET OPTIONS ('format.max_row_group_size' '50');

statement ok
CREATE EXTERNAL TABLE t STORED AS PARQUET WITH ORDER (s ASC) LOCATION 'test_files/scratch/rule_order_reenforce/t.parquet';

statement ok
COPY (SELECT CASE WHEN 1<0 THEN NULL ELSE 100000 END AS k) TO 'test_files/scratch/rule_order_reenforce/two/a.parquet' STORED AS PARQUET;

statement ok
COPY (SELECT CASE WHEN 1<0 THEN NULL ELSE 100001 END AS k) TO 'test_files/scratch/rule_order_reenforce/two/b.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE two STORED AS PARQUET LOCATION 'test_files/scratch/rule_order_reenforce/two/';

query III
SELECT min(s), max(s), count(*) FROM (SELECT s FROM t WHERE y = 1 ORDER BY s LIMIT 1000) a WHERE a.s NOT IN (SELECT k FROM two);
----
1 2998 1000

statement ok
DROP TABLE t;

statement ok
DROP TABLE two;
