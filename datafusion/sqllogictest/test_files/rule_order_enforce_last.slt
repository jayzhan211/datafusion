# This file runs `EnsureRequirements` last (see `rule_order.rs`). `PushdownSort` has
# already removed the sort, and the marker is gone, so enforcement has to keep the plan's
# order with no `LIMIT` involved.

statement ok
SET datafusion.execution.batch_size = 2;

statement ok
SET datafusion.optimizer.repartition_file_min_size = 1;

statement ok
COPY (SELECT value AS s, value%4 AS g FROM generate_series(1,60)) TO 'test_files/scratch/rule_order_enforce_last/t.parquet' STORED AS PARQUET OPTIONS ('format.max_row_group_size' '7');

statement ok
CREATE EXTERNAL TABLE t STORED AS PARQUET WITH ORDER (s ASC) LOCATION 'test_files/scratch/rule_order_enforce_last/t.parquet';

query I
SELECT s FROM t ORDER BY s;
