# This file runs `LimitPushdown` before `AggregateStatistics` (see
# `rule_order.rs`). A scan's statistics must reflect its fetch, or `COUNT(*)` is
# answered from the row count of the whole table.

statement ok
CREATE TABLE t (i BIGINT) AS VALUES (1), (2), (3), (4), (5);

query I
SELECT COUNT(*) FROM t;
----
5

query I
SELECT COUNT(*) FROM (SELECT i FROM t LIMIT 1);
----
1

query I
SELECT COUNT(*) FROM (SELECT i FROM t LIMIT 3);
----
3

query I
SELECT COUNT(*) FROM (SELECT i FROM t LIMIT 9);
----
5

statement ok
DROP TABLE t;
