# This file runs `LimitPushdown` before `EnsureRequirements` (see `rule_order.rs`).
# A fetch on a scan applies to each partition, so a `LIMIT` must stay above the
# scan's partitions until enforcement adds the merge that combines them.

statement ok
set datafusion.execution.target_partitions = 2;

statement ok
COPY (VALUES (1, 10), (2, 20), (3, 30), (4, 40))
TO 'test_files/scratch/rule_order_limit_pushdown/part-0.csv'
STORED AS CSV OPTIONS ('format.has_header' 'true');

statement ok
COPY (VALUES (5, 50), (6, 60), (7, 70), (8, 80))
TO 'test_files/scratch/rule_order_limit_pushdown/part-1.csv'
STORED AS CSV OPTIONS ('format.has_header' 'true');

statement ok
CREATE EXTERNAL TABLE t (id BIGINT, val BIGINT)
STORED AS CSV
LOCATION 'test_files/scratch/rule_order_limit_pushdown/'
OPTIONS ('format.has_header' 'true');

query I
SELECT COUNT(*) FROM (SELECT id FROM t LIMIT 3);
----
3

query I
SELECT COUNT(*) FROM (SELECT id FROM t OFFSET 2 LIMIT 3);
----
3

query I
SELECT COUNT(*) FROM (SELECT id FROM t OFFSET 6);
----
2

query I
SELECT COUNT(*) FROM (SELECT id FROM (SELECT id FROM t LIMIT 5) LIMIT 2);
----
2

statement ok
DROP TABLE t;

statement ok
set datafusion.execution.target_partitions = 4;
