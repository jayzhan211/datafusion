# This file runs `LimitPushPastWindows` before `EnsureRequirements` (see
# `rule_order.rs`). The window's own sort isn't there yet, so the first sort below it
# belongs to the subquery, whose limit can't be lowered. Whichever rows the subquery
# keeps, sum(x) over x DESC is fixed: 60->60, 50->110, 40->150, 30->180, 20->200, 10->210.

statement ok
COPY (SELECT column1 AS s, column2 AS x FROM (VALUES (1,10),(2,20),(3,30),(4,40),(5,50),(6,60))) TO 'test_files/scratch/rule_order_window_limit/t.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE t (s BIGINT, x BIGINT) STORED AS PARQUET LOCATION 'test_files/scratch/rule_order_window_limit/t.parquet';

query II rowsort
SELECT x, sum(x) OVER (ORDER BY x DESC ROWS UNBOUNDED PRECEDING) FROM (SELECT * FROM t ORDER BY s LIMIT 100) LIMIT 2;
----
50 110
60 60

statement ok
DROP TABLE t;
