# This file runs `EnsureRequirements` after `PushdownSort` (see `rule_order.rs`). The
# subquery's limit is on the scan, so the outer sort's larger fetch can't replace it.

statement ok
COPY (SELECT value AS s, value%2 AS y FROM generate_series(1, 12)) TO 'test_files/scratch/rule_order_sort_fetch/a.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE t (s BIGINT, y BIGINT) STORED AS PARQUET WITH ORDER (s ASC) LOCATION 'test_files/scratch/rule_order_sort_fetch/a.parquet';

query I
SELECT s FROM (SELECT s FROM t LIMIT 2) ORDER BY s LIMIT 5;
----
1
2

statement ok
DROP TABLE t;
