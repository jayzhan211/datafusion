# This file runs `CombinePartialFinalAggregate` before `EnsureRequirements` (see
# `rule_order.rs`). Combining before enforcement would make it repartition on the
# raw group key below the aggregate, which evaluates a volatile key a second time.

query BI
SELECT k, c FROM (SELECT counted_volatile(value) <= 3 AS k, count(*) AS c FROM generate_series(1, 10) GROUP BY counted_volatile(value) <= 3) WHERE k;
----
true 3

query I
SELECT evaluations();
----
10
