# This file runs `ProjectionPushdown` before `FilterPushdown`, with filters pushed into
# the scan (see `rule_order.rs`). The scan takes `random() AS r`, and a filter on r can't
# be rewritten to a second, independent `random()`. r <> r holds for no row.

statement ok
SET datafusion.execution.parquet.pushdown_filters = true;

statement ok
COPY (SELECT value AS v FROM generate_series(1,2000)) TO 'test_files/scratch/rule_order_volatile_filter/big.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE big (v BIGINT) STORED AS PARQUET LOCATION 'test_files/scratch/rule_order_volatile_filter/big.parquet';

query I
SELECT count(*) FROM (SELECT r, r a, r b FROM (SELECT random() r FROM big)) WHERE a <> b;
----
0

statement ok
SET datafusion.execution.parquet.pushdown_filters = false;

statement ok
DROP TABLE big;
