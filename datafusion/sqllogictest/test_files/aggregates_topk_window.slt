# TopK aggregation keeps only the groups the sort above it needs, so it can't apply below
# an operator that reads other rows. There are 4 groups, and g=4 is the 4th by g.
statement ok
COPY (SELECT column1 AS g, column2 AS x FROM (VALUES (1,100),(2,90),(3,10),(4,5))) TO 'test_files/scratch/aggregates_topk_window/a.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE a (g BIGINT, x BIGINT) STORED AS PARQUET LOCATION 'test_files/scratch/aggregates_topk_window/a.parquet';

query II
SELECT g, row_number() OVER (ORDER BY g) FROM (SELECT g, min(x) mn FROM a GROUP BY g) ORDER BY mn ASC LIMIT 1;
----
4 4

query II
SELECT g, count(*) OVER () FROM (SELECT g, min(x) mn FROM a GROUP BY g) ORDER BY mn ASC LIMIT 1;
----
4 4

# An alias that reuses the aggregate's name doesn't make the sort key that aggregate.
statement ok
COPY (SELECT column1 AS g, column2 AS x FROM (VALUES (1,100),(2,90),(3,10),(4,5))) TO 'test_files/scratch/aggregates_topk_window/a2.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE a2 (g BIGINT, x BIGINT) STORED AS PARQUET LOCATION 'test_files/scratch/aggregates_topk_window/a2.parquet';

query II
SELECT g, -"min(a2.x)" AS "min(a2.x)" FROM (SELECT g, min(x) FROM a2 GROUP BY g) ORDER BY "min(a2.x)" ASC LIMIT 2;
----
1 -100
2 -90

statement ok
DROP TABLE a;

statement ok
DROP TABLE a2;
