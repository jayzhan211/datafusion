# This file runs `PushdownSort` and the `OutputRequirements` remove step before
# `EnsureRequirements` (see `rule_order.rs`). A sort over several partitions also
# merges them, so `PushdownSort` must keep a merge when it removes the sort.

statement ok
set datafusion.execution.target_partitions = 3;

statement ok
COPY (SELECT column1 AS id, column2 AS val FROM (VALUES (1, 10), (2, 20), (3, 30))) TO 'test_files/scratch/rule_order_pushdown_sort/a.parquet';

statement ok
COPY (SELECT column1 AS id, column2 AS val FROM (VALUES (4, 40), (5, 50), (6, 60))) TO 'test_files/scratch/rule_order_pushdown_sort/b.parquet';

statement ok
COPY (SELECT column1 AS id, column2 AS val FROM (VALUES (7, 70), (8, 80), (9, 90))) TO 'test_files/scratch/rule_order_pushdown_sort/c.parquet';

statement ok
CREATE EXTERNAL TABLE t (id BIGINT, val BIGINT)
STORED AS PARQUET
LOCATION 'test_files/scratch/rule_order_pushdown_sort/'
WITH ORDER (id ASC);

query II
SELECT id, val FROM t ORDER BY id;
----
1 10
2 20
3 30
4 40
5 50
6 60
7 70
8 80
9 90

query II
SELECT id, val FROM t ORDER BY id LIMIT 2;
----
1 10
2 20

statement ok
DROP TABLE t;

statement ok
set datafusion.execution.target_partitions = 4;

# With one partition `PushdownSort` removes the sort, then enforcement adds partitions
# below the projection. The order the plan provides has to survive that.
statement ok
COPY (SELECT value AS s FROM generate_series(1,200000)) TO 'test_files/scratch/rule_order_pushdown_sort/t.parquet' STORED AS PARQUET OPTIONS ('format.max_row_group_size' '5');

statement ok
CREATE EXTERNAL TABLE t (s BIGINT) STORED AS PARQUET WITH ORDER (s ASC) LOCATION 'test_files/scratch/rule_order_pushdown_sort/t.parquet';

query II
SELECT s, s + 1 FROM t ORDER BY s LIMIT 2;
----
1 2
2 3

statement ok
DROP TABLE t;

# The limit of an `ORDER BY` ends up on the scan, and splitting the scan would keep other
# rows.
statement ok
set datafusion.execution.batch_size = 2;

statement ok
set datafusion.optimizer.repartition_file_min_size = 1;

statement ok
COPY (SELECT value AS s FROM generate_series(1, 60) ORDER BY s)
TO 'test_files/scratch/rule_order_pushdown_sort/split.parquet'
STORED AS PARQUET OPTIONS ('format.max_row_group_size' '6');

statement ok
CREATE EXTERNAL TABLE split (s BIGINT) STORED AS PARQUET WITH ORDER (s ASC)
LOCATION 'test_files/scratch/rule_order_pushdown_sort/split.parquet';

query II
SELECT max(u), count(*) FROM (SELECT unnest(make_array(s, s + 1)) u FROM (SELECT s FROM split ORDER BY s LIMIT 4));
----
5 8

statement ok
DROP TABLE split;

statement ok
RESET datafusion.execution.batch_size;

statement ok
RESET datafusion.optimizer.repartition_file_min_size;
